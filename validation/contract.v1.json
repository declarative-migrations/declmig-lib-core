{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/declarative-migrations/declmig-lib-core/validation/contract.v1.json",
  "contractVersion": "ores.validation.v1",
  "owner": "declarative-migrations/declmig-lib-core",
  "publicAuthority": "https://github.com/declarative-migrations/declmig-interfaces/tree/main/validation",
  "routeAuthority": "https://github.com/ORESoftware/api-docs",
  "visibility": {
    "public": ["request-meta", "page-query", "problem-details"],
    "server": ["trusted-actor", "server-request-context", "internal-command"]
  },
  "languageBindings": {
    "typescript": {"library": "zod", "publicPackage": "@declarative-migrations/declmig-validation", "serverPackage": "@declarative-migrations/declmig-validation-server"},
    "rust": {"library": "garde", "publicPackage": "declmig-validation", "serverPackage": "declmig-validation-server"},
    "golang": {"library": "go-playground/validator/v10", "publicPackage": "github.com/declarative-migrations/declmig-lib-core/validation/golang", "serverPackage": "github.com/declarative-migrations/declmig-lib-core/validation/golang-server"},
    "gleam": {"library": "gleam/dynamic/decode", "publicPackage": "declmig_validation", "serverPackage": "declmig_validation_server"}
  },
  "rules": {
    "clientExportsPublicOnly": true,
    "serverMayImportPublic": true,
    "serverDefinitionsNeverEmittedToClients": true,
    "routeBindingsUseApiDocsOperationId": true,
    "unknownFieldsRejectedWhereRuntimeSupportsIt": true,
    "authorityDiscrepancyPausesRelease": true
  }
}
