// Pure source-level AttoLang schema policy, not an executable migration plan.
define module schema_authority_oracles as
  pub fnc promote(bool typespec_matches, bool authored_json_matches,
                  bool reviewed_dpm_matches, bool diesel_matches,
                  bool seaorm_matches, bool shadow_catalog_matches,
                  bool independent_review): bool {
    return typespec_matches && authored_json_matches &&
      reviewed_dpm_matches && diesel_matches &&
      seaorm_matches && shadow_catalog_matches &&
      independent_review;
  }

  pub fnc self_check(): bool {
    return promote(true,true,true,true,true,true,true) &&
      !promote(false,true,true,true,true,true,true) &&
      !promote(true,false,true,true,true,true,true) &&
      !promote(true,true,true,true,true,false,true) &&
      !promote(true,true,true,true,true,true,false);
  }
end
